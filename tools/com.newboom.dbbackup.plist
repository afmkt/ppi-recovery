<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily newboom DB backup agent (macOS launchd).
  Runs tools/backup_newboom.sh every day at 03:00. launchd's environment is
  minimal, so PATH / PYTHON / NEWBOOM_REPO are set explicitly here.

  Install:  cp tools/com.newboom.dbbackup.plist ~/Library/LaunchAgents/
  Load:     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.newboom.dbbackup.plist
  Trigger now (test):  launchctl kickstart -k gui/$(id -u)/com.newboom.dbbackup
  Unload:   launchctl bootout gui/$(id -u)/com.newboom.dbbackup
  Logs:     data/backups/backup.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.newboom.dbbackup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/michael/code/python/newboom/tools/backup_newboom.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/anaconda3/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHON</key>
    <string>/opt/anaconda3/bin/python3</string>
    <key>NEWBOOM_REPO</key>
    <string>/Users/michael/code/python/newboom</string>
  </dict>

  <!-- Daily at 03:00. launchd runs a missed (asleep) job on next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/michael/code/python/newboom/data/backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/michael/code/python/newboom/data/backups/backup.log</string>
</dict>
</plist>
