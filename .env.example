DATABASE_URL=sqlite:///data/newboom.db
UPLOAD_DIR=data/uploads

# Background worker cadence (seconds) and the staleness window (seconds) after
# which /healthz reports the worker unhealthy. Widen WORKER_STALE_S in slow
# environments so a long-but-healthy cycle isn't mistaken for a stuck worker.
# WORKER_INTERVAL_S=10
# WORKER_STALE_S=30